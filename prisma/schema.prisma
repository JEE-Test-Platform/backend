// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User profile based on role
  student     Student?
  institute   Institute?
  operator    Operator?
  superAdmin  SuperAdmin?

  @@map("users")
}

model Student {
  id               String   @id @default(cuid())
  userId           String   @unique
  instituteId      String   // Student belongs to one institute
  firstName        String
  lastName         String
  phone            String?
  dateOfBirth      DateTime?
  gender           Gender?
  address          String?
  city             String?
  state            String?
  pincode          String?
  guardianName     String?
  guardianPhone    String?
  emergencyContact String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute        Institute         @relation(fields: [instituteId], references: [id], onDelete: Restrict)

  // Student specific relations
  testAttempts     TestAttempt[]

  @@map("students")
}

model Institute {
  id              String   @id @default(cuid())
  userId          String   @unique
  instituteName   String
  registrationNo  String?  @unique
  address         String
  city            String
  state           String
  pincode         String
  phone           String
  website         String?
  establishedYear Int?
  principalName   String?
  contactPerson   String
  contactEmail    String
  contactPhone    String
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Institute specific relations
  students        Student[]
  testActivations InstituteTestActivation[]

  @@map("institutes")
}

model Operator {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String
  lastName    String
  phone       String
  department  String?
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Operator creates master tests
  masterTests MasterTest[]

  @@map("operators")
}

model SuperAdmin {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String
  lastName    String
  phone       String
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("super_admins")
}

// Master Test created by Operator - reusable across institutes
model MasterTest {
  id              String        @id @default(cuid())
  title           String
  description     String?
  testType        TestType      @default(MOCK_TEST) // JEE_MAIN, JEE_ADVANCED, MOCK_TEST, etc.
  duration        Int           // Duration in minutes
  totalMarks      Int
  passingMarks    Int
  instructions    String?
  isActive        Boolean       @default(true)
  createdById     String        // Operator who created this
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  createdBy       Operator      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  // Master Test relations
  questions       Question[]
  activations     InstituteTestActivation[]

  @@map("master_tests")
}

// Institute activates a master test for their students
model InstituteTestActivation {
  id              String        @id @default(cuid())
  instituteId     String
  masterTestId    String
  activationDate  DateTime      // When test becomes available
  expiryDate      DateTime      // When test expires
  startTime       DateTime?     // Optional: specific exam start time
  endTime         DateTime?     // Optional: specific exam end time
  isActive        Boolean       @default(true)
  maxAttempts     Int           @default(1) // How many times students can attempt
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  institute       Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  masterTest      MasterTest    @relation(fields: [masterTestId], references: [id], onDelete: Restrict)

  // Activation relations
  attempts        TestAttempt[]

  @@unique([instituteId, masterTestId]) // One activation per test per institute
  @@map("institute_test_activations")
}

model Question {
  id              String           @id @default(cuid())
  masterTestId    String
  questionText    String
  questionType    QuestionType
  subject         Subject
  difficulty      Difficulty
  marks           Int
  correctAnswer   String?          // For numerical/true-false questions (null for MCQ)
  explanation     String?
  imageUrl        String?
  questionOrder   Int              // Order in test
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  masterTest      MasterTest       @relation(fields: [masterTestId], references: [id], onDelete: Cascade)

  // Question relations
  options         Option[]         // MCQ options as separate table
  answers         StudentAnswer[]

  @@map("questions")
}

// Separate Option model for better analytics and flexibility
model Option {
  id              String           @id @default(cuid())
  questionId      String
  optionLabel     String           // A, B, C, D
  optionText      String
  optionImageUrl  String?
  isCorrect       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  question        Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("options")
}

model TestAttempt {
  id                  String           @id @default(cuid())
  studentId           String
  testActivationId    String           // Links to institute's test activation
  attemptNumber       Int              @default(1) // 1st attempt, 2nd attempt, etc.
  startedAt           DateTime         @default(now())
  submittedAt         DateTime?
  timeSpent           Int?             // Time in minutes
  totalMarks          Int?
  obtainedMarks       Int?
  percentage          Float?
  isPassed            Boolean?
  rank                Int?             // Rank in this institute for this test
  status              AttemptStatus    @default(IN_PROGRESS)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  student             Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testActivation      InstituteTestActivation     @relation(fields: [testActivationId], references: [id], onDelete: Cascade)

  // Attempt relations
  answers             StudentAnswer[]

  @@unique([studentId, testActivationId, attemptNumber]) // Allow multiple attempts per activation
  @@map("test_attempts")
}

model StudentAnswer {
  id              String       @id @default(cuid())
  attemptId       String
  questionId      String
  selectedAnswer  String?      // For MCQ: option label (A/B/C/D), for Numerical: the number
  answerText      String?      // Additional text if needed
  isCorrect       Boolean?
  marksObtained   Int?
  timeSpent       Int?         // Time in seconds
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  attempt         TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("student_answers")
}

enum Role {
  STUDENT
  INSTITUTE
  OPERATOR
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Subject {
  PHYSICS
  CHEMISTRY
  MATHEMATICS
  GENERAL_KNOWLEDGE
}

enum QuestionType {
  MCQ
  NUMERICAL
  TRUE_FALSE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  SUBMITTED
  EXPIRED
}

enum TestType {
  JEE_MAIN
  JEE_ADVANCED
  NEET
  MOCK_TEST
  PRACTICE_TEST
  CUSTOM
}